[Unit]
Description=LIMITLESS Trading Bot — Streamlit Dashboard
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/limitless
EnvironmentFile=/home/ubuntu/limitless/.env
ExecStart=/home/ubuntu/limitless/venv/bin/streamlit run dashboard/app.py \
    --server.address 0.0.0.0 \
    --server.port 8501 \
    --server.headless true
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
