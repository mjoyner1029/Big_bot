[Unit]
Description=LIMITLESS Autonomous Trading Bot
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/limitless
EnvironmentFile=/home/ubuntu/limitless/.env
ExecStart=/home/ubuntu/limitless/venv/bin/python main.py
Restart=always
RestartSec=30
StandardOutput=append:/home/ubuntu/limitless/logs/bot.log
StandardError=append:/home/ubuntu/limitless/logs/bot.log

# Graceful shutdown: give the bot 60s to save state before kill
TimeoutStopSec=60
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
