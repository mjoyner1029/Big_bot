# Bot 1: Day Trader — Stocks, Technical Analysis, Market Hours Only
BOT_NAME=DayTrader
TRADING_CAPITAL=2000
ASSET_CLASS=stocks
STOCK_WATCHLIST=NVDA,AAPL,TSLA,AMD,MSFT,META,GOOGL,AMZN,SPY,QQQ
TRADING_MODE=balanced
LOOP_INTERVAL_SECONDS=300
CONFIDENCE_THRESHOLD=0.58
MAX_OPEN_POSITIONS=3
MAX_POSITION_PCT=0.15
RISK_PER_TRADE_PCT=0.01
STATE_PATH=state/bot1_state.json
TRADE_LOG_PATH=logs/bot1_trades.csv
BOT_LOG_PATH=logs/bot1.log

# Market hours only (stocks)
ENFORCE_MARKET_HOURS=true
FLATTEN_OVERNIGHT=true

# Strategies
ENABLE_OPTIONS_TRADING=false
ENABLE_CATALYST_SWING=false
ENABLE_SHORT_SELLING=false
ENABLE_DYNAMIC_CRYPTO=false
ENABLE_PENNY_STOCKS=true
MAX_PENNY_STOCKS=5

# Safety
USE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false
