# Bot 5: Position Trader — Weeks to Months Holds
# Captures major trends with wider stops and longer hold times

# ── Bot Identity ──────────────────────────────────────────────────
BOT_NAME=PositionTrader
STATE_PATH=state/bot5_state.json
LOG_PATH=logs/bot5.log
TRADE_LOG_PATH=logs/bot5_trades.csv
PID_FILE=pids/PositionTrader.pid

# ── Capital & Risk ────────────────────────────────────────────────
TRADING_CAPITAL=2000
RISK_PER_TRADE_PCT=0.015            # 1.5% risk (lower than day trading)
MAX_OPEN_POSITIONS=3                # Fewer positions, bigger size each
MAX_POSITION_PCT=0.35               # 35% of capital per position

# ── Holding Period ────────────────────────────────────────────────
MAX_HOLD_DAYS=90                    # Hold up to 3 months
SWING_MIN_MAGNITUDE=60.0            # Higher conviction threshold
SWING_TRAILING_STOP_PCT=0.10        # 10% trailing stop (wider than day trading)

# ── Asset Focus ──────────────────────────────────────────────────
ASSET_CLASS=stocks                  # Stocks only (better for position trading)
STOCK_WATCHLIST=NVDA,AAPL,MSFT,GOOGL,AMZN,TSLA,META,PLTR,MSTR,SPY,QQQ

# ── Trading Hours ────────────────────────────────────────────────
TRADING_START_HOUR=9                # Market open
TRADING_END_HOUR=16                 # Market close
HOLD_OVERNIGHT=true                 # Key difference: hold positions overnight

# ── Strategy Selection ───────────────────────────────────────────
# Focus on trend-following and swing strategies (not scalping)
ENABLE_BREAKOUT=true
ENABLE_EMA_TREND_FOLLOW=true
ENABLE_MOMENTUM_FACTOR=true
ENABLE_CATALYST_SWING=true
ENABLE_RSI_DIVERGENCE=true

# Disable high-frequency strategies
ENABLE_VWAP_REVERSION=false
ENABLE_GAP_AND_GO=false
ENABLE_CRYPTO_MOMENTUM=false

# ── Safety Controls ──────────────────────────────────────────────
CIRCUIT_BREAKER_DRAWDOWN_PCT=0.15   # 15% max drawdown (wider tolerance)
CIRCUIT_BREAKER_CONSECUTIVE_LOSSES=5
EMERGENCY_STOP_LOSS_PCT=0.25        # 25% total loss = halt

# ── Paper Trading (default) ──────────────────────────────────────
USE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false

# ── Market Data ──────────────────────────────────────────────────
PERIOD=3mo                          # Longer lookback for trend analysis
INTERVAL=1d                         # Daily bars (not hourly)

# ── Execution ────────────────────────────────────────────────────
TRADING_MODE=balanced
CYCLE_INTERVAL_SEC=3600             # Check once per hour (not every 60s)

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENABLE_TRADE_LOGGING=true
