# Bot 2: Crypto Scalper — 24/7, High Frequency, Top Coins Only
BOT_NAME=CryptoScalper
TRADING_CAPITAL=2000
ASSET_CLASS=crypto
CRYPTO_WATCHLIST=BTC-USD,ETH-USD,SOL-USD,BNB-USD,XRP-USD
TRADING_MODE=aggressive
LOOP_INTERVAL_SECONDS=60
CONFIDENCE_THRESHOLD=0.52
MAX_OPEN_POSITIONS=5
MAX_POSITION_PCT=0.12
RISK_PER_TRADE_PCT=0.005
STATE_PATH=state/bot2_state.json
TRADE_LOG_PATH=logs/bot2_trades.csv
BOT_LOG_PATH=logs/bot2.log

# 24/7 trading (crypto)
ENFORCE_MARKET_HOURS=false
FLATTEN_OVERNIGHT=false

# Crypto discovery
ENABLE_DYNAMIC_CRYPTO=true
MAX_DYNAMIC_CRYPTO=10

# Strategies
ENABLE_OPTIONS_TRADING=false
ENABLE_CATALYST_SWING=false
ENABLE_SHORT_SELLING=false

# Safety
USE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false
