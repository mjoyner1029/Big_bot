# Bot 3: Options Trader — High Conviction Calls & Puts Only
BOT_NAME=OptionsTrader
TRADING_CAPITAL=2000
ASSET_CLASS=stocks
STOCK_WATCHLIST=SPY,QQQ,NVDA,AAPL,TSLA,AMD,META,GOOGL,MSFT
TRADING_MODE=conservative
LOOP_INTERVAL_SECONDS=600
CONFIDENCE_THRESHOLD=0.70
MAX_OPEN_POSITIONS=3
MAX_POSITION_PCT=0.20
RISK_PER_TRADE_PCT=0.02
STATE_PATH=state/bot3_state.json
TRADE_LOG_PATH=logs/bot3_trades.csv
BOT_LOG_PATH=logs/bot3.log

# Market hours (options)
ENFORCE_MARKET_HOURS=true
FLATTEN_OVERNIGHT=false

# Options strategy
ENABLE_OPTIONS_TRADING=true
OPTIONS_MIN_CONFIDENCE=0.72
OPTIONS_RISK_PCT=0.03
OPTIONS_EXPIRY_DAYS=21

# Disable other strategies
ENABLE_CATALYST_SWING=false
ENABLE_SHORT_SELLING=false
ENABLE_SPOT_TRADING=false

# Safety
USE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false
