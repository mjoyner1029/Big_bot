# Bot 4: Swing Trader — Catalyst Holds, Days to Weeks
BOT_NAME=SwingTrader
TRADING_CAPITAL=2000
ASSET_CLASS=stocks
STOCK_WATCHLIST=PLTR,MSTR,OKLO,SMR,IONQ,RGTI,TTWO,CRWD,PANW,DDOG,NET,SNOW
TRADING_MODE=conservative
LOOP_INTERVAL_SECONDS=3600
CONFIDENCE_THRESHOLD=0.65
MAX_OPEN_POSITIONS=5
MAX_POSITION_PCT=0.18
RISK_PER_TRADE_PCT=0.02
STATE_PATH=state/bot4_state.json
TRADE_LOG_PATH=logs/bot4_trades.csv
BOT_LOG_PATH=logs/bot4.log

# Don't flatten overnight (swing holds)
ENFORCE_MARKET_HOURS=true
FLATTEN_OVERNIGHT=false

# Swing strategy
ENABLE_CATALYST_SWING=true
SWING_MIN_MAGNITUDE=60.0
MAX_SWING_POSITIONS=5
SWING_TRAILING_STOP_PCT=0.07

# Disable day trading strategies
ENABLE_OPTIONS_TRADING=false
ENABLE_SHORT_SELLING=false

# Safety
USE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false
